# LLM providers
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Tavily search (https://tavily.com) — required for the ch02 search-agent examples
TAVILY_API_KEY=

# LangSmith tracing (https://smith.langchain.com) — optional but recommended:
# turns on full prompt/response traces for every chain/agent call.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=langchain-course
